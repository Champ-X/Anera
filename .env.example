# Required for the local, executable Agent Harness.
DEEPSEEK_API_KEY=

# Default text model; an explicit value overrides the application default.
# Changing this default does not rewrite existing sessions' model selections.
DEEPSEEK_MODEL=deepseek-flash
# Optional comma-separated model allowlist. Official endpoint defaults to Flash + V4 Pro.
# ANERA_AGENT_MODELS=deepseek-flash,deepseek-v4-pro

# Stream real provider reasoning and replay it across tool calls.
# Use disabled for direct answers, or auto to inherit the provider default.
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
ANERA_MAX_OUTPUT_TOKENS=16384

# Optional production-backed Web providers.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Optional media providers. OPENAI_API_KEY is accepted in place of
# ANERA_IMAGE_API_KEY; the same compatible endpoint powers image and speech.
PEXELS_API_KEY=
ANERA_IMAGE_API_KEY=
ANERA_IMAGE_BASE_URL=https://api.openai.com/v1
ANERA_IMAGE_MODEL=gpt-image-1
ANERA_SPEECH_MODEL=gpt-4o-mini-tts

# DeepSeek Vision defaults to the Arena-compatible experimental model.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Fail fast and retry when DeepSeek accepts a request but emits no SSE frame.
ANERA_MODEL_FIRST_EVENT_TIMEOUT_MS=20000

# Long visual workflows can require several source/render/Vision passes. This
# is an orphan-run safety boundary, not a model-step or token budget.
ANERA_RUN_TIMEOUT_MS=7200000

# Optional durable per-turn Agent + context-compaction ceilings (0 = off). Explicit
# Continue/Resume starts a new turn; checkpointing or restarting the service
# while a turn is paused does not reset them.
ANERA_MAX_AGENT_MODEL_REQUESTS_PER_TURN=0
# 0 disables the cumulative per-turn token stop without disabling metering.
ANERA_MAX_AGENT_TOTAL_TOKENS_PER_TURN=0

# Optional public origin when the Express application is reverse-proxied.
ANERA_PUBLIC_BASE_URL=

# Fail closed when macOS Seatbelt or Linux Bubblewrap is unavailable.
# Set to false only for trusted local debugging.
ANERA_REQUIRE_OS_SANDBOX=true
